# Geração de imagensIMAGE_API_KEY=sua_chave_aquiIMAGE_MODEL=stable‑diffusion‑xlIMAGE_ASPECT_RATIO=9:16
# Avatar falante e sincronização labialAVATAR_API_KEY=sua_chave_avatar_aquiTTS_VOICE=pt‑BR‑feminino‑naturalAVATAR_MOVEMENT=true
# Vídeos longos e ediçãoFFMPEG_PATH=/usr/bin/ffmpegBLOCK_DURATION=60AUTO_MERGE=true
# Gerador de clipes viraisCLIP_MIN_DURATION=45CLIP_FORMAT=9:16
# Galeria UGC expandidaGALLERY_MAX_STORAGE=unlimited
